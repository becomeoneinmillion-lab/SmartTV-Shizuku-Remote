<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="10dp">

    <!-- Top Pairing Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnScanQr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#1E88E5"
            android:textColor="#FFFFFF"
            android:text="Scan QR" />

        <Button
            android:id="@+id/btnToggleView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:layout_marginHorizontal="6dp"
            android:backgroundTint="#8E24AA"
            android:textColor="#FFFFFF"
            android:text="Switch: TV Remote" />

        <Button
            android:id="@+id/btnOpenTvMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#424242"
            android:textColor="#FFFFFF"
            android:text="TV Mode" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Disconnected (Tap Scan QR)"
        android:textColor="#00E676"
        android:textSize="12sp"
        android:paddingVertical="4dp" />

    <!-- VIEW 1: Trackpad + Dedicated Scroll Bar -->
    <LinearLayout
        android:id="@+id/layoutMousePad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:visibility="visible">

        <FrameLayout
            android:id="@+id/trackpadArea"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#1E1E1E">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="60FPS MOUSE TRACKPAD\n\n• Slide = Move TV Cursor\n• Single Tap = Click\n• Double Tap = TV OK"
                android:textColor="#666666" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/scrollBarArea"
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="#2C2C2C">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:rotation="90"
                android:text="SCROLL"
                android:textColor="#AAAAAA"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- VIEW 2: Full Smart TV Remote Pad -->
    <LinearLayout
        android:id="@+id/layoutTvRemote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#1A1A1A"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Power / Mute / Menu Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnPower" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:backgroundTint="#D32F2F" android:textColor="#FFF" android:text="Power" />
            <Button android:id="@+id/btnMute" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:text="Mute" />
            <Button android:id="@+id/btnMenu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Menu" />
        </LinearLayout>

        <!-- D-Pad Navigation -->
        <Button android:id="@+id/btnDpadUp" android:layout_width="110dp" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="▲ UP" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="6dp">
            <Button android:id="@+id/btnDpadLeft" android:layout_width="100dp" android:layout_height="56dp" android:text="◀ LEFT" />
            <Button android:id="@+id/btnDpadCenter" android:layout_width="90dp" android:layout_height="56dp" android:layout_marginHorizontal="8dp" android:backgroundTint="#1E88E5" android:textColor="#FFF" android:text="OK" />
            <Button android:id="@+id/btnDpadRight" android:layout_width="100dp" android:layout_height="56dp" android:text="RIGHT ▶" />
        </LinearLayout>
        <Button android:id="@+id/btnDpadDown" android:layout_width="110dp" android:layout_height="56dp" android:layout_marginBottom="16dp" android:text="▼ DOWN" />

        <!-- Volume & Channel Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnVolDown" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Vol -" />
            <Button android:id="@+id/btnVolUp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:text="Vol +" />
            <Button android:id="@+id/btnChDown" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="CH -" />
            <Button android:id="@+id/btnChUp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CH +" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Always-Visible Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Back" />
        <Button android:id="@+id/btnHome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:text="Home" />
        <Button android:id="@+id/btnPlayPause" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="⏯" />
        <Button android:id="@+id/btnKeyboard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:backgroundTint="#43A047" android:textColor="#FFFFFF" android:text="Keyboard" />
    </LinearLayout>

    <EditText
        android:id="@+id/etHiddenKeyboard"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:inputType="textNoSuggestions" />
</LinearLayout>
